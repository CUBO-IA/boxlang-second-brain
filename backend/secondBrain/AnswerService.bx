/**
 * Role B — 03.5/03.6 claims, labels and citation validation before publish.
 */
class {
	private boolean function fragmentExists(required array retrieved, required string fragmentId) {
		for ( var fragment in arguments.retrieved ) {
			if ( fragment.id == arguments.fragmentId ) return true;
		}
		return false;
	}

	private struct function fragmentById(required array retrieved, required string fragmentId) {
		for ( var fragment in arguments.retrieved ) {
			if ( fragment.id == arguments.fragmentId ) return fragment;
		}
		throw( message="Unknown fragment id for citation" );
	}

	private string function normalizeToken(required string token) {
		var t = lCase(trim(arguments.token));
		t = reReplace(t, "[^a-z0-9áéíóúñü]+", "", "all");
		if ( listFindNoCase("aprobacion,aprobación,approval,approve,granted,concede,conceder", t) ) return "approval";
		if ( listFindNoCase("solicitar,solicitud,request,apply", t) ) return "request";
		if ( listFindNoCase("formulario,form", t) ) return "form";
		if ( listFindNoCase("directora,director,manager", t) ) return "director";
		if ( listFindNoCase("cumplimiento,compliance", t) ) return "compliance";
		if ( listFindNoCase("quien,quién,who", t) ) return "who";
		if ( listFindNoCase("como,cómo,how", t) ) return "how";
		if ( listFindNoCase("responsable,owner", t) ) return "owner";
		return t;
	}

	private boolean function isStopword(required string token) {
		// Function words that create false lexical overlap (e.g. "del" in absent questions).
		return listFindNoCase(
			"the,and,for,with,from,that,this,are,was,were,you,your,del,las,los,una,uno,unos,unas,por,para,con,sin,sobre,como,cómo,quien,quién,cual,cuál,que,qué,este,esta,estos,estas,ese,esa,esos,esas,hay,ser,esta,está,son,fue,han,tiene,todo,toda,muy,mas,más,also,into,about",
			arguments.token
		) > 0;
	}

	private array function tokens(required string text) {
		var raw = reReplace(lCase(arguments.text), "[^a-z0-9áéíóúñü]+", " ", "all");
		var parts = listToArray(raw, " ", false, true);
		var out = [];
		for ( var part in parts ) {
			var normalized = normalizeToken(part);
			if ( len(normalized) >= 3 && !isStopword(normalized) ) out.append(normalized);
		}
		return out;
	}

	private numeric function overlapScore(required string question, required string fragmentText) {
		var q = tokens(arguments.question);
		var f = tokens(arguments.fragmentText);
		if ( q.len() == 0 || f.len() == 0 ) return 0;
		var hits = 0;
		for ( var qt in q ) {
			for ( var ft in f ) {
				if ( qt == ft ) {
					hits++;
					break;
				}
			}
		}
		return hits;
	}

	struct function abstain(required string reason) {
		return {
			ok: true,
			abstained: true,
			reason: arguments.reason,
			claims: [],
			citations: [],
			missing: arguments.reason
		};
	}

	/**
	 * Build a published answer from model content + retrieved fragments.
	 * Invalid citation IDs are rejected; no fabricated support is published.
	 */
	struct function buildFromRetrieved(
		required string modelText,
		required array retrieved,
		required array claimSpecs
	) {
		if ( arguments.retrieved.len() == 0 ) {
			return abstain("no_evidence_in_selection");
		}
		if ( findNoCase("INSUFFICIENT_EVIDENCE", arguments.modelText) || !len(trim(arguments.modelText)) ) {
			return abstain("model_reported_insufficient_evidence");
		}
		if ( arguments.claimSpecs.len() == 0 ) {
			return abstain("no_verifiable_claims");
		}
		var claims = [];
		var citations = [];
		var citationIndex = 1;
		for ( var spec in arguments.claimSpecs ) {
			var label = lCase(trim(spec.label ?: "supported"));
			if ( !listFindNoCase("supported,inferred,uncertain", label) ) throw( message="Invalid claim label" );
			var supportIds = spec.supportFragmentIds ?: [];
			if ( !isArray(supportIds) ) throw( message="supportFragmentIds must be an array" );
			if ( label == "supported" && supportIds.len() == 0 ) {
				throw( message="Supported claims require at least one fragment" );
			}
			if ( label == "inferred" && supportIds.len() == 0 ) {
				throw( message="Inferred claims require cited premises" );
			}
			var claimCitations = [];
			for ( var fragmentId in supportIds ) {
				if ( !fragmentExists(arguments.retrieved, fragmentId) ) {
					throw( message="Claim references fragment outside retrieved set" );
				}
				var fragment = fragmentById(arguments.retrieved, fragmentId);
				var citation = {
					id: "c" & citationIndex,
					documentId: fragment.documentId,
					fragmentId: fragment.id,
					location: fragment.location,
					excerpt: left(fragment.text, 240),
					status: "current"
				};
				citations.append(citation);
				claimCitations.append(citation.id);
				citationIndex++;
			}
			claims.append({
				text: trim(spec.text ?: ""),
				label: label,
				citationIds: claimCitations,
				premises: label == "inferred" ? claimCitations : []
			});
		}
		return {
			ok: true,
			abstained: false,
			answerText: arguments.modelText,
			claims: claims,
			citations: citations
		};
	}

	/**
	 * Heuristic claim planner for the provider-double path (no real model JSON).
	 * - no lexical overlap → abstain
	 * - weak overlap → inferred with premises
	 * - strong overlap → supported
	 */
	struct function planClaimsFromRetrieval(required string question, required array retrieved) {
		if ( arguments.retrieved.len() == 0 ) return { claimSpecs: [], abstain: true, reason: "no_evidence_in_selection" };
		var specs = [];
		var best = 0;
		for ( var fragment in arguments.retrieved ) {
			var score = overlapScore(arguments.question, fragment.text);
			if ( score > best ) best = score;
			if ( score >= 2 ) {
				specs.append({
					text: left(fragment.text, 200),
					label: "supported",
					supportFragmentIds: [ fragment.id ]
				});
			} else if ( score == 1 ) {
				specs.append({
					text: "Inferencia a partir de la evidencia citada.",
					label: "inferred",
					supportFragmentIds: [ fragment.id ]
				});
			}
		}
		if ( specs.len() == 0 ) {
			return { claimSpecs: [], abstain: true, reason: "question_not_supported_by_evidence" };
		}
		return { claimSpecs: specs, abstain: false, bestOverlap: best };
	}

	/** Safe wrapper for tests: never throws across script try/catch compiler edge cases. */
	struct function tryBuildFromRetrieved(required string modelText, required array retrieved, required array claimSpecs) {
		try {
			return { ok: true, answer: buildFromRetrieved(arguments.modelText, arguments.retrieved, arguments.claimSpecs) };
		} catch ( any failure ) {
			return { ok: false, reason: left(toString(failure.message ?: "invalid_answer"), 240) };
		}
	}
}
