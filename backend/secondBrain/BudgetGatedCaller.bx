import secondBrain.BudgetService;

/**
 * Reserves budget before invoking a provider (real or double); settles or retains on outcome.
 */
class {
	property name="budget";
	property name="provider";

	function init(required any budget, required any provider) {
		variables.budget = arguments.budget;
		variables.provider = arguments.provider;
		return this;
	}

	private boolean function validTokens(required any value) {
		return isInstanceOf(arguments.value, "java.lang.Number") && createObject("java", "java.lang.Double").isFinite(arguments.value.doubleValue()) && arguments.value >= 0 && arguments.value <= 2147483647 && fix(arguments.value) == arguments.value;
	}

	struct function chat(required string prompt, required string model, numeric estimatedPromptTokens=32, numeric estimatedCompletionTokens=32) {
		// UTF-8 bytes bound tokenizer input; 64 tokens cover the single-message envelope.
		var inputBytes = len(charsetDecode(arguments.prompt, "UTF-8"));
		if ( inputBytes > 32000 || !validTokens(arguments.estimatedPromptTokens) || !validTokens(arguments.estimatedCompletionTokens) || arguments.estimatedCompletionTokens < 1 || arguments.estimatedCompletionTokens > 4096 ) return {ok: false, denied: true, providerCalled: false, reason: "input_limit"};
		var promptBound = max(arguments.estimatedPromptTokens, inputBytes + 64);
		var estimate = variables.budget.estimateChatUSD(promptBound, arguments.estimatedCompletionTokens);
		var reservation = variables.budget.reserve("chat", arguments.model, estimate);
		if ( !reservation.ok ) {
			return { ok: false, denied: true, reason: reservation.reason, providerCalled: false, reservation: reservation };
		}
		try {
			var response = variables.provider.chat(arguments.prompt, arguments.model, arguments.estimatedCompletionTokens);
			var usage = response.usage ?: {};
			if ( !isStruct(usage) || !structKeyExists(usage, "prompt_tokens") || !structKeyExists(usage, "completion_tokens") || !validTokens(usage.prompt_tokens) || !validTokens(usage.completion_tokens) ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_usage_unknown");
				return {ok: false, denied: false, providerCalled: true, reason: "provider_usage_unknown", reservationId: reservation.reservationId};
			}
			var promptTokens = usage.prompt_tokens;
			var completionTokens = usage.completion_tokens;
			var totalTokens = promptTokens + completionTokens;
			var actual = variables.budget.estimateChatUSD(promptTokens, completionTokens);
			var settled = variables.budget.settle(reservation.reservationId, actual, promptTokens, completionTokens, totalTokens, "success");
			return {
				ok: settled.ok,
				reason: settled.reason,
				denied: false,
				providerCalled: true,
				response: response,
				reservation: reservation,
				settlement: settled,
				actualUSD: actual
			};
		} catch ( any failure ) {
			var typeName = failure.type ?: "";
			if ( findNoCase("timeout", typeName) || findNoCase("timeout", failure.message ?: "") ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_timeout");
				return {
					ok: false,
					denied: false,
					providerCalled: true,
					timeout: true,
					reason: "provider_timeout",
					reservationId: reservation.reservationId
				};
			}
			variables.budget.markUnknown(reservation.reservationId, "provider_error");
			return {
				ok: false,
				denied: false,
				providerCalled: true,
				reason: "provider_error",
				reservationId: reservation.reservationId
			};
		}
	}

	struct function embed(required string text, required string model, numeric estimatedPromptTokens=0) {
		var inputBytes = len(charsetDecode(arguments.text, "UTF-8"));
		if ( inputBytes < 1 || inputBytes > 8192 || !validTokens(arguments.estimatedPromptTokens) ) return {ok: false, denied: true, providerCalled: false, reason: "input_limit"};
		var tokens = max(inputBytes, arguments.estimatedPromptTokens);
		var estimate = variables.budget.estimateEmbedUSD(tokens);
		var reservation = variables.budget.reserve("embed", arguments.model, estimate);
		if ( !reservation.ok ) {
			return { ok: false, denied: true, reason: reservation.reason, providerCalled: false, reservation: reservation };
		}
		try {
			var response = variables.provider.embed(arguments.text, arguments.model);
			var usage = response.usage ?: {};
			if ( !isStruct(usage) || !structKeyExists(usage, "prompt_tokens") || !validTokens(usage.prompt_tokens) ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_usage_unknown");
				return {ok: false, denied: false, providerCalled: true, reason: "provider_usage_unknown", reservationId: reservation.reservationId};
			}
			var promptTokens = usage.prompt_tokens;
			var actual = variables.budget.estimateEmbedUSD(promptTokens);
			var settled = variables.budget.settle(reservation.reservationId, actual, promptTokens, 0, promptTokens, "success");
			return {
				ok: settled.ok,
				reason: settled.reason,
				denied: false,
				providerCalled: true,
				response: response,
				reservation: reservation,
				settlement: settled,
				actualUSD: actual,
				vector: response.data[1].embedding
			};
		} catch ( any failure ) {
			var typeName = failure.type ?: "";
			if ( findNoCase("timeout", typeName) || findNoCase("timeout", failure.message ?: "") ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_timeout");
				return {
					ok: false,
					denied: false,
					providerCalled: true,
					timeout: true,
					reason: "provider_timeout",
					reservationId: reservation.reservationId
				};
			}
			variables.budget.markUnknown(reservation.reservationId, "provider_error");
			return {
				ok: false,
				denied: false,
				providerCalled: true,
				reason: "provider_error",
				reservationId: reservation.reservationId
			};
		}
	}
}
