import secondBrain.BudgetService;

/**
 * Reserves budget before invoking a provider (real or double); settles or retains on outcome.
 */
class {
	property name="budget";
	property name="provider";

	function init(required any budget, required any provider) {
		variables.budget = arguments.budget;
		variables.provider = arguments.provider;
		return this;
	}

	struct function chat(required string prompt, required string model, numeric estimatedPromptTokens=32, numeric estimatedCompletionTokens=32) {
		var estimate = variables.budget.estimateChatUSD(arguments.estimatedPromptTokens, arguments.estimatedCompletionTokens);
		var reservation = variables.budget.reserve("chat", arguments.model, estimate);
		if ( !reservation.ok ) {
			return { ok: false, denied: true, reason: reservation.reason, providerCalled: false, reservation: reservation };
		}
		try {
			var response = variables.provider.chat(arguments.prompt, arguments.model);
			var usage = response.usage ?: {};
			var promptTokens = usage.prompt_tokens ?: arguments.estimatedPromptTokens;
			var completionTokens = usage.completion_tokens ?: arguments.estimatedCompletionTokens;
			var totalTokens = usage.total_tokens ?: (promptTokens + completionTokens);
			var actual = variables.budget.estimateChatUSD(promptTokens, completionTokens);
			var settled = variables.budget.settle(reservation.reservationId, actual, promptTokens, completionTokens, totalTokens, "success");
			return {
				ok: true,
				denied: false,
				providerCalled: true,
				response: response,
				reservation: reservation,
				settlement: settled,
				actualUSD: actual
			};
		} catch ( any failure ) {
			var typeName = failure.type ?: "";
			if ( findNoCase("timeout", typeName) || findNoCase("timeout", failure.message ?: "") ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_timeout");
				return {
					ok: false,
					denied: false,
					providerCalled: true,
					timeout: true,
					reason: "provider_timeout",
					reservationId: reservation.reservationId
				};
			}
			variables.budget.markUnknown(reservation.reservationId, "provider_error");
			return {
				ok: false,
				denied: false,
				providerCalled: true,
				reason: "provider_error",
				reservationId: reservation.reservationId
			};
		}
	}

	struct function embed(required string text, required string model, numeric estimatedPromptTokens=0) {
		var tokens = arguments.estimatedPromptTokens > 0 ? arguments.estimatedPromptTokens : max(1, ceiling(len(arguments.text) / 4));
		var estimate = variables.budget.estimateEmbedUSD(tokens);
		var reservation = variables.budget.reserve("embed", arguments.model, estimate);
		if ( !reservation.ok ) {
			return { ok: false, denied: true, reason: reservation.reason, providerCalled: false, reservation: reservation };
		}
		try {
			var response = variables.provider.embed(arguments.text, arguments.model);
			var usage = response.usage ?: {};
			var promptTokens = usage.prompt_tokens ?: tokens;
			var actual = variables.budget.estimateEmbedUSD(promptTokens);
			var settled = variables.budget.settle(reservation.reservationId, actual, promptTokens, 0, promptTokens, "success");
			return {
				ok: true,
				denied: false,
				providerCalled: true,
				response: response,
				reservation: reservation,
				settlement: settled,
				actualUSD: actual,
				vector: response.data[1].embedding
			};
		} catch ( any failure ) {
			var typeName = failure.type ?: "";
			if ( findNoCase("timeout", typeName) || findNoCase("timeout", failure.message ?: "") ) {
				variables.budget.markUnknown(reservation.reservationId, "provider_timeout");
				return {
					ok: false,
					denied: false,
					providerCalled: true,
					timeout: true,
					reason: "provider_timeout",
					reservationId: reservation.reservationId
				};
			}
			variables.budget.markUnknown(reservation.reservationId, "provider_error");
			return {
				ok: false,
				denied: false,
				providerCalled: true,
				reason: "provider_error",
				errorSafe: left(toString(failure.message ?: "provider_error"), 240),
				reservationId: reservation.reservationId
			};
		}
	}
}
