/** Exercises the installed bx-ai PostgresVectorMemory, not a replacement store. */
class {
	array function selectedSearch( required any memory, required array embedding, required string spaceId, required array documentIds, numeric limit=10, boolean omitDocumentFilter=false ) {
		if ( arguments.documentIds.isEmpty() ) return [];
		var merged = [];
		var seen = {};
		for ( var documentId in arguments.documentIds ) {
			// bx-ai supports scalar JSONB equality. Query each authorized document before ANN ranking.
			var filter = arguments.omitDocumentFilter ? { spaceId=arguments.spaceId } : { spaceId=arguments.spaceId, documentId=documentId };
			var matches = arguments.memory.findSimilar( arguments.embedding, arguments.limit, filter );
			for ( var match in matches ) if ( !structKeyExists( seen, match.id ) ) { seen[ match.id ]=true; merged.append( match ); }
		}
		merged.sort( ( left, right ) => right.score - left.score );
		return merged.slice( 1, min( arguments.limit, merged.len() ) );
	}

	function vectorLifecycle() {
		var table = "p00_" & lCase( replace( createUUID(), "-", "", "all" ) );
		var memory = new bxModules.bxai.models.memory.vector.PostgresVectorMemory( collection=table );
		try {
			memory.configure( {
				datasource: "secondBrain",
				table: table,
				collection: table,
				dimensions: 3,
				distanceFunction: "L2",
				indexType: "HNSW"
			} );
			memory.storeDocument( "a-1", "same phrase A first", [ 0, 1, 0 ], { spaceId="A", documentId="doc-a", revision=1, fragment=1 } );
			memory.storeDocument( "a-2", "same phrase A second", [ 0, 0.9, 0.1 ], { spaceId="A", documentId="doc-a", revision=1, fragment=2 } );
			memory.storeDocument( "sibling-1", "same phrase sibling", [ 0, 0, 1 ], { spaceId="A", documentId="sibling", revision=1, fragment=1 } );
			memory.storeDocument( "b-1", "same phrase B closer", [ 0.999, 0.001, 0 ], { spaceId="B", documentId="doc-b", revision=1, fragment=1 } );

			var unrestricted = memory.findSimilar( [ 1, 0, 0 ], 10, {} );
			if ( unrestricted[ 1 ].id != "b-1" ) throw( message="Synthetic B fixture must be nearest; got #unrestricted.map( ( row ) => row.id ).toList()#" );
			// Test-only mutation switches prove each guard fails closed when omitted.
			var fault = getSystemSetting( "P00_PROBE_FAULT", "" );
			var isolated = memory.findSimilar( [ 1, 0, 0 ], 10, fault == "space" ? {} : { spaceId="A" } );
			if ( isolated.len() != 3 || isolated.some( ( row ) => row.metadata.spaceId != "A" ) ) throw( message="Space filter missing from bx-ai retrieval" );
			var isolatedContext = isolated.map( ( row ) => row.text ).toList( "\n" );
			if ( findNoCase( "same phrase B closer", isolatedContext ) ) throw( message="Cross-space document would enter model context" );
			var authorizedIds = fault == "selection" ? [ "doc-a" ] : [ "doc-a", "sibling" ];
			var selected = selectedSearch( memory, [ 1, 0, 0 ], "A", authorizedIds, 10, fault == "selection" );
			var selectedIds = selected.map( ( row ) => row.id );
			var documentSet = {}; var idSet = {};
			selected.each( ( row ) => { documentSet[ row.metadata.documentId ]=true; idSet[ row.id ]=true; } );
			if ( selected.len() != 3 || structCount(documentSet) != 2 || structCount(idSet) != selectedIds.len() || !selectedIds.contains( "a-1" ) || !selectedIds.contains( "a-2" ) || !selectedIds.contains( "sibling-1" ) || selected.some( ( row ) => !authorizedIds.contains( row.metadata.documentId ) || row.metadata.spaceId != "A" ) ) throw( message="Multi-document selection/merge/dedupe failed: #selectedIds.toList()#" );
			var selectedContext = selected.map( ( row ) => row.text ).toList( "\n" );
			if ( findNoCase( "same phrase B closer", selectedContext ) ) throw( message="Unselected cross-space document would enter model context" );
			if ( !selectedSearch( memory, [ 1, 0, 0 ], "A", [], 10 ).isEmpty() ) throw( message="Empty document selection must produce an empty context without a broad query" );

			var siblingBefore = memory.getById( "sibling-1" );
			var bBefore = memory.getById( "b-1" );
			var removed = fault == "replace" ? 0 : memory.removeWhere( { spaceId="A", documentId="doc-a" } );
			if ( removed != 2 ) throw( message="Expected all old document fragments to be removed" );
			memory.storeDocument( "a-1", "replacement A first", [ 0, 0, 1 ], { spaceId="A", documentId="doc-a", revision=2, fragment=1 } );
			memory.storeDocument( "a-2", "replacement A second", [ 0.1, 0, 0.9 ], { spaceId="A", documentId="doc-a", revision=2, fragment=2 } );
			var stale = memory.findSimilar( [ 1, 0, 0 ], 10, { spaceId="A", documentId="doc-a" } );
			if ( stale.len() != 2 || stale.some( ( row ) => row.metadata.revision != 2 || findNoCase( "same phrase", row.text ) ) ) throw( message="Replacement left stale vectors/text or incorrect metadata" );
			var replacementVector = memory.getById( "a-1" ).embedding;
			if ( replacementVector[ 3 ] != 1 ) throw( message="Replacement did not replace the stored vector" );
			var siblingAfter = memory.getById( "sibling-1" );
			if ( siblingAfter.text != siblingBefore.text || siblingAfter.metadata.revision != siblingBefore.metadata.revision || siblingAfter.embedding.toList() != siblingBefore.embedding.toList() ) throw( message="Sibling changed during document replacement" );

			if ( fault != "delete" && ( !memory.remove( "a-1" ) || !memory.remove( "a-2" ) ) ) throw( message="bx-ai remove failed for replacement fragments" );
			if ( !memory.getById( "a-1" ).isEmpty() || !memory.getById( "a-2" ).isEmpty() ) throw( message="Deleted document still has vectors" );
			var siblingAfterDelete = memory.getById( "sibling-1" );
			var bAfterDelete = memory.getById( "b-1" );
			if ( siblingAfterDelete.text != siblingBefore.text || siblingAfterDelete.metadata.revision != siblingBefore.metadata.revision || siblingAfterDelete.embedding.toList() != siblingBefore.embedding.toList() ) throw( message="Delete changed same-space sibling" );
			if ( bAfterDelete.text != bBefore.text || bAfterDelete.metadata.spaceId != bBefore.metadata.spaceId || bAfterDelete.embedding.toList() != bBefore.embedding.toList() ) throw( message="Delete changed other-space data" );
			return "OK: bx-ai PostgresVectorMemory; B nearest excluded; selected 2/3 docs via per-document pre-ranking filters; top-k score merge/dedupe; empty selection; 2-fragment replace/delete; siblings preserved";
		} finally {
			queryExecute( "DROP TABLE IF EXISTS #table#", {}, { datasource="secondBrain" } );
		}
	}
}
