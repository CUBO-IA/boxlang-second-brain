# Solo desarrollo local. Sustituye la contraseña antes de levantar los servicios.
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=second_brain_local_only
POSTGRES_PORT=55433
FRONTEND_PORT=3000
BACKEND_PORT=8080
# Defaults to http://127.0.0.1:$FRONTEND_PORT; set explicitly for a different browser origin.
# APP_ORIGIN=http://127.0.0.1:3000

# Opt-in manual provider probe only. Never commit a real key.
OPENAI_API_KEY=
P00_ALLOW_PROVIDER_CALLS=NO
P00_MAX_USD=1
P00_PRICE_DATE=2026-10-11
P00_PRICE_REFERENCE=https://developers.openai.com/api/docs/pricing
P00_CHAT_INPUT_USD_PER_MILLION=0.10
P00_CHAT_OUTPUT_USD_PER_MILLION=0.50
P00_EMBED_USD_PER_MILLION=0.02
