import secondBrain.TextChunker;

function verify(required boolean condition, required string message) {
	if ( !arguments.condition ) throw(message=arguments.message);
}

function run() {
	var text = "🔎 Repeatable phrase.\n";
	for ( var i = 1; i <= 60; i++ ) text &= "a";
	text &= "\n🔎 Repeatable phrase.\n";
	for ( var i = 1; i <= 60; i++ ) text &= "z";
	var extracted = {text:text, lines:new secondBrain.TextNoteExtractor().lines(text), spaceId:"1", documentId:"00000000-0000-0000-0000-000000000001", revisionId:"00000000-0000-0000-0000-000000000002"};
	var fragments = new TextChunker(32, 24, 30).chunkExtracted(extracted);
	var javaText = createObject("java", "java.lang.String").init(text);
	var phrase = "🔎 Repeatable phrase.";
	var secondMatch = javaText.lastIndexOf(phrase);
	var secondStart = javaText.codePointCount(0, secondMatch);
	var secondEnd = secondStart + javaText.codePointCount(secondMatch, secondMatch + phrase.length());
	var secondFound = false;

	for ( var fragment in fragments ) {
		var location = fragment.location;
		verify(location.startOffset >= 0 && location.endOffset > location.startOffset, "Each nonempty fragment stores a codepoint range");
		var startUnit = javaText.offsetByCodePoints(0, location.startOffset);
		var endUnit = javaText.offsetByCodePoints(0, location.endOffset);
		verify(javaText.substring(startUnit, endUnit) == fragment.text, "Stored range selects exactly its fragment (including supplementary characters)");
		if ( location.startOffset <= secondStart && location.endOffset >= secondEnd ) secondFound = true;
	}

	verify(secondFound, "The second repeated phrase has its own citation range");
	println("OK: exact end-exclusive Unicode codepoint ranges select the proper repeated phrase across chunks and lines.");
}

run();
